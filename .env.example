# -----------------------------------------------------------------------------
# Rutify: variables de entorno
# Copiá este archivo a .env.local y completalo. .env.local NUNCA se commitea.
# Los valores salen de Supabase Dashboard → Project Settings → API Keys / Data API.
# -----------------------------------------------------------------------------

# URL del proyecto (pública, llega al navegador)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co

# Publishable key (sb_publishable_...). Es pública: la seguridad la da RLS.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

# -----------------------------------------------------------------------------
# Solo para scripts locales (seed). NUNCA con prefijo NEXT_PUBLIC_ y nunca en
# el deploy de la app: la secret key ignora RLS.
# -----------------------------------------------------------------------------

# Secret key (sb_secret_...)
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxxxxx

# Email del usuario entrenador (creado en Auth → Users). El seed le asigna los ejercicios.
ENTRENADOR_EMAIL=entrenador@ejemplo.com

# Contraseña de la base (Project Settings → Database). La usa la CLI para
# `npm run db:push`; también se puede pasar a mano con --password.
SUPABASE_DB_PASSWORD=
